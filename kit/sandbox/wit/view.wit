/// A page of the UI kit that lives in a sandbox.
///
/// The page's logic runs in a module that can reach nothing but this interface: it has no
/// file, no network, no clock and no environment unless the application hands one over as an
/// import. What it shows is a tree of boxes and lines of text that it hands out for every frame
/// (`render`); the application lays the tree out, draws it in the terminal's own font and
/// theme, and tells the module what the person did (`handle`). The module can ask the
/// application where things stand on the page it last laid out (`layout`), which is how it
/// knows what is under the pointer.
///
/// Lengths are in points. Colours are, by preference, roles of the theme (its nine roles, its
/// sixteen ANSI colours, its selection, and the values it derives from them) and the application
/// resolves them in the pane's theme; a page that needs a colour no role says gives it as a
/// value, with one for a dark theme if it wants. The application resolves neither the value nor
/// the choice between its two forms: it takes the one that goes with the brightness of its theme.
///
/// A page that a program in the pane opened can talk to that program: it says things with
/// `program.send` and hears the program's in `page.message`. The application only carries them —
/// the words are the program's and the page's own.
///
/// What the program can take is the program's: it may be a process that reads when it likes. A
/// page that says more than the program has read is told so (`program.send` answers `full`),
/// keeps what it wanted to say, and is called once when the program has read enough
/// (`page.room`); it does not ask again and again, and it is not closed for being fast. What the
/// program says to the page is held to what the page has taken (the program's own `write` slows
/// down), so a page is never handed more than it can read.
package pencere:view@2.0.0;

interface types {
    /// A name for an element, so that what is kept about it between frames (a scroll position,
    /// a highlight on its way) and what the application is asked of it (its box) can find it.
    /// Any 64-bit number; the same words hash to the same number on both sides.
    type id = u64;

    record point {
        x: f32,
        y: f32,
    }

    record size {
        w: f32,
        h: f32,
    }

    record rect {
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }

    /// A part of one of the lists a frame (or a menu) carries once for all its elements: `len`
    /// items from the `start`th. See `frame`.
    record slice {
        start: u32,
        len: u32,
    }

    /// How large the content of a scrolling box is against how large the box is, points: it can
    /// be scrolled down by `content.h - view.h` and across by `content.w - view.w`. `offset` is how
    /// far it is scrolled across and down, within that.
    record extent {
        content: size,
        view: size,
        offset: point,
    }

    /// What a colour is called: the nine roles of the theme, its ANSI palette and its selection,
    /// and the values it derives from them.
    variant role {
        background,
        foreground,
        dim,
        accent,
        cursor,
        success,
        error,
        info,
        warning,
        /// A surface this many steps above the background.
        raised(u8),
        /// Text a step quieter than the foreground.
        quiet,
        /// The colour of rules and borders: the hairline between things.
        border,
        /// The colour a shadow is cast in.
        shadow,
        /// The ground of what the person selected.
        selection,
        /// The sixteen colours of the theme's ANSI palette, by xterm's names: the normal eight,
        /// then the bright eight.
        black,
        red,
        green,
        yellow,
        blue,
        magenta,
        cyan,
        white,
        bright-black,
        bright-red,
        bright-green,
        bright-yellow,
        bright-blue,
        bright-magenta,
        bright-cyan,
        bright-white,
    }

    /// A colour value: sRGB, eight bits a channel, `a` the opacity (`255` solid).
    record rgba {
        r: u8,
        g: u8,
        b: u8,
        a: u8,
    }

    /// A colour value for a light theme and, where it is not the same on a dark one, for that.
    record rgba-forms {
        light: rgba,
        dark: option<rgba>,
    }

    /// Where a colour comes from: a role of the theme, or a value of the page's own.
    variant source {
        role(role),
        rgba(rgba-forms),
    }

    /// A colour with an opacity, `0.0..=1.0`, on top of the value's own.
    /// How far a colour is taken toward another: `amount` of the way from its own source to
    /// `toward` (`0.0` is the colour, `1.0` is `toward`), channel by channel in sRGB, the opacity
    /// of a value included. A highlight that comes in is the ground taken toward its colour, a
    /// word that brightens is `dim` taken toward `foreground`.
    record mix {
        toward: source,
        amount: f32,
    }

    /// A colour: its source, taken toward another where `mix` says so, with an opacity,
    /// `0.0..=1.0`, on top of what that comes to.
    record color {
        source: source,
        mix: option<mix>,
        alpha: f32,
    }

    /// A size along one axis.
    variant length {
        /// As much as the content and the siblings leave.
        auto,
        /// Points.
        px(f32),
        /// A share of the parent's size, `0.0..=100.0`.
        percent(f32),
    }

    record range {
        min: f32,
        fr: f32,
    }

    /// A column or a row of a grid.
    variant track {
        /// Points.
        px(f32),
        /// A share of what the fixed tracks leave.
        fr(f32),
        /// At least `min` points, then a share of what is left.
        range(range),
        /// As much as the content wants.
        auto,
    }

    enum display {
        flex,
        grid,
        none,
    }

    enum direction {
        row,
        column,
    }

    enum items {
        start,
        center,
        end,
        stretch,
    }

    enum justify {
        start,
        center,
        end,
        between,
    }

    enum overflow {
        /// Children may spill out of the box.
        visible,
        /// Nothing is drawn outside the box.
        hidden,
        /// As `hidden`, and the content is scrolled behind the box, down and across. How far is
        /// the application's, kept by the element's id (one with none does not scroll): the
        /// wheel, the trackpad and the scroll bars move it as the application's system does, the
        /// page is told where it stands (`event.scrolled`, `extent.offset`) and asks for it to
        /// go somewhere (`layout.scroll-to`).
        scroll,
    }

    enum family {
        /// The system's face.
        system,
        /// The terminal's own face.
        terminal,
    }

    enum align {
        start,
        center,
        end,
    }

    /// Top, right, bottom, left; points.
    record edges {
        top: f32,
        right: f32,
        bottom: f32,
        left: f32,
    }

    /// The distances of an absolute box's edges from its parent's; an absent edge is free.
    record inset {
        top: option<f32>,
        right: option<f32>,
        bottom: option<f32>,
        left: option<f32>,
    }

    /// Radii, points.
    record corners {
        top-left: f32,
        top-right: f32,
        bottom-right: f32,
        bottom-left: f32,
    }

    /// A border drawn inside the box, over its fill.
    record border {
        width: f32,
        color: color,
    }

    /// A fill that runs from `start` to `end` along a line at `angle` degrees, as a style sheet's
    /// `linear-gradient`: `180` from the top down, `90` from the left to the right. It is drawn
    /// over the box's `fill`, and a line of text on it is read against its colour half way along.
    record gradient {
        angle: f32,
        start: color,
        end: color,
    }

    /// The side of an element an overlay stands on.
    enum side {
        below,
        above,
        right,
        left,
    }

    /// Where an overlay stands: beside the element named `to`, on `side` of it (on the other where
    /// the page has not the room on that one), `gap` points away, lined up with the start, the
    /// middle or the end of the element along that side, and moved along it to stay on the page.
    /// Where no element of that name is on the page, it stands where its `inset` puts it.
    record anchor {
        to: id,
        side: side,
        align: align,
        gap: f32,
    }

    /// A soft shadow: the box's silhouette moved by `(dx, dy)` and blurred over `blur`, never
    /// drawn under the box itself.
    record shadow {
        dx: f32,
        dy: f32,
        blur: f32,
        color: color,
    }

    /// The text properties an element sets for itself and the elements under it; an absent one
    /// is the nearest ancestor's.
    record text-style {
        family: option<family>,
        size: option<f32>,
        weight: option<u16>,
        /// The face's italic (or oblique) form, where it has one.
        italic: option<bool>,
        /// A line under the words, as a link has.
        underline: option<bool>,
        /// A line through the words, as a thing that was given up has.
        strike: option<bool>,
        color: option<color>,
        align: option<align>,
    }

    /// How an element is laid out, how it looks and how the text inside it is set.
    record style {
        display: display,
        direction: direction,
        /// A row that is too long goes on in a new line below.
        wrap: bool,
        /// Taken out of the flow and placed by `inset` against the parent's box.
        absolute: bool,
        /// Taken out of the flow and out of every box that holds it: placed by `inset` against the
        /// page (or beside the element `anchor` names), drawn over everything else, cut by nothing
        /// that holds it, and the first the pointer finds. It is as faint as what holds it, hidden
        /// with it, and its keys go out through it.
        overlay: bool,
        /// For an overlay: the element it stands beside.
        anchor: option<anchor>,
        inset: inset,
        width: length,
        height: length,
        min-width: length,
        min-height: length,
        max-width: length,
        max-height: length,
        padding: edges,
        margin: edges,
        /// Between columns, between rows; points.
        gap-x: f32,
        gap-y: f32,
        grow: f32,
        /// An absent shrink is the usual 1.
        shrink: option<f32>,
        items: option<items>,
        justify: option<justify>,
        /// The tracks of a grid's columns and rows: parts of the frame's `tracks`.
        columns: slice,
        rows: slice,
        /// How many grid columns the element takes (`0` or `1`: one).
        column-span: u16,
        overflow: overflow,
        fill: option<color>,
        gradient: option<gradient>,
        border: option<border>,
        radii: corners,
        shadow: option<shadow>,
        /// How much of the element shows, `0.0..=1.0`, with everything inside it: each thing it
        /// draws is that much fainter (where the things inside overlap, they show through each
        /// other). A panel that fades in, a part that is not to be used now.
        opacity: f32,
        text: text-style,
        /// A line that does not fit ends in "..." and gives its room away first.
        truncate: bool,
    }

    /// A small line chart.
    record spark {
        /// Values over time, newest last: a part of the frame's `numbers`.
        values: slice,
        color: color,
        /// The value the top of the box stands for; the largest value when absent.
        peak: option<f32>,
    }

    /// How an image fills its box.
    enum fit {
        /// All of the image, as large as the box lets it be with its proportions kept.
        contain,
        /// The box filled, the proportions kept; what does not fit is cut off, evenly on both
        /// sides.
        cover,
    }

    /// A picture: a file of the bundle the page came in, drawn into the element's box. The
    /// element's size is its style's; a side the style leaves out follows the image's
    /// proportions, and an element that says neither is the image's own size in pixels, a
    /// point to a pixel. The formats are PNG, JPEG and SVG, and the application holds them to
    /// its limits; one it cannot read leaves the box empty.
    record image {
        /// The path of the file in the bundle, as its manifest names it: a part of the frame's
        /// `text`.
        src: slice,
        fit: fit,
        /// A colour for a picture that is a shape: every pixel of it is this colour, with the
        /// picture's opacity at that pixel. How much of it shows is the element's `opacity`.
        tint: option<color>,
    }

    /// A part of a text of many looks: its words, and what it changes of the element's look (what
    /// it leaves out is the element's). The size is the element's for every part.
    record span {
        /// A part of the frame's `text`.
        text: slice,
        color: option<color>,
        weight: option<u16>,
        italic: option<bool>,
        underline: option<bool>,
        strike: option<bool>,
        family: option<family>,
        /// A ground behind the words of this part alone.
        background: option<color>,
        /// The part is a link of this name: it answers the pointer as a pressed element does, and
        /// a screen reader says it is a link.
        link: option<id>,
    }

    record quad-to {
        control: point,
        to: point,
    }

    record cubic-to {
        a: point,
        b: point,
        to: point,
    }

    /// A step of a path, in the points of the canvas's box from its top-left corner.
    variant segment {
        /// A new part of the path starts here; nothing is drawn.
        move-to(point),
        /// A straight line.
        line-to(point),
        /// A curve bent toward `control` (a quadratic Bézier).
        quad-to(quad-to),
        /// A curve leaving toward `a` and arriving from `b` (a cubic Bézier).
        cubic-to(cubic-to),
        /// A straight line back to where the part began.
        close,
    }

    /// The line along a path: `width` points, round where it turns and ends.
    record stroke {
        width: f32,
        color: color,
    }

    /// A path of a canvas: its steps (a part of the frame's `segments`), the colour inside it (where
    /// a line out of a point crosses the path an odd number of times) and the line along it.
    record path {
        segments: slice,
        fill: option<color>,
        stroke: option<stroke>,
    }

    /// What an element is.
    variant content {
        /// A box that holds the elements after it.
        box,
        /// One line of text: a part of the frame's `text`.
        text(slice),
        /// A text of many looks: its parts, a part of the frame's `spans`, as one paragraph that
        /// runs from line to line where it wraps.
        rich(slice),
        spark(spark),
        image(image),
        /// Paths drawn in the box: a part of the frame's `paths`. It has no size of its own.
        canvas(slice),
    }

    /// What an element is to a screen reader, where its look says it and its answers do not. (A
    /// text field is one by `node.field`; an element that answers the pointer and says nothing is
    /// a button.)
    variant accessible-role {
        button,
        text,
        link,
        /// Checked or not (`state.checked`).
        checkbox,
        /// On or off (`state.checked`).
        switch,
        /// One of a set of which one is chosen (`state.checked`).
        radio,
        /// A tab; the one in front is `state.selected`.
        tab,
        /// An entry of a menu, or of a list that is picked from.
        menu-item,
        /// The title of what follows, of a level from 1 down.
        heading(u8),
        /// A picture, said by its label.
        image,
        /// How far something has come (`state.value`).
        progress,
        /// A value set by moving something along a line (`state.value`).
        slider,
    }

    /// Where an element stands, to a screen reader.
    record state {
        /// On or off; none for what is neither.
        checked: option<bool>,
        /// The one chosen of several.
        selected: bool,
        /// Open or shut; none for what does not open.
        expanded: option<bool>,
        /// It cannot be used now: it does not answer the pointer, nor take the keyboard.
        disabled: bool,
        /// The value it shows, in words: a part of the frame's `text`.
        value: option<slice>,
    }

    /// Keys that do a command: one key, with the modifiers held down with it.
    record shortcut {
        key: key,
        mods: mods,
    }

    /// Something the page can be told to do: the application lists it (by `title`, a part of the
    /// frame's `text`) where a person looks for what can be done, and tells the page `id` when it
    /// is asked for there or by its keys (`event.command`), in place of the key. One that is not
    /// `enabled` is listed and cannot be done.
    record command {
        id: id,
        title: slice,
        keys: option<shortcut>,
        enabled: bool,
    }

    /// What a text field the application puts over the page takes.
    enum field-kind {
        /// One line: enter is a key for the page.
        line,
        /// Lines: enter breaks the line, and the field scrolls the lines it has no room for.
        lines,
        /// One line whose characters are not shown (a password), and which is never copied.
        secret,
    }

    /// How a move goes over its time.
    enum ease {
        /// At one pace from start to end.
        linear,
        /// Fast at first, settling at the end (`cubic-bezier(0.2, 0, 0, 1)`): what most changes
        /// are.
        out,
        /// Slow at both ends (`cubic-bezier(0.4, 0, 0.2, 1)`).
        in-out,
        /// As a spring that does not bounce: quick, and long in coming to rest.
        spring,
    }

    /// Where an element comes in from or goes to, as a difference from where it is: this opacity
    /// of its own, moved this far (points), over this time (seconds).
    record shift {
        opacity: f32,
        dx: f32,
        dy: f32,
        seconds: f32,
    }

    /// How a change of an element moves instead of jumping, as a style sheet's `transition` and a
    /// motion library's layout animation: the application does the moving, frame by frame, and
    /// does not ask the page for the frames in between. The element is followed by its `id` from
    /// one frame to the next; one with no id does not move. Nothing moves under Reduce Motion, on
    /// the frame the page changes size, or for what scrolling brings into view or takes out of it.
    record motion {
        /// How long a change takes, seconds.
        seconds: f32,
        ease: ease,
        /// The colours of its fill, border, shadow and words follow a change.
        color: bool,
        /// Its opacity follows a change.
        opacity: bool,
        /// A width or height given in points follows a change (one that is not snaps).
        size: bool,
        /// Moved among the others, it slides from where it was to where it is.
        place: bool,
        /// How it comes in when it appears on a page that was there before it.
        enter: option<shift>,
        /// How it goes when it is no longer on the page: the application keeps drawing it as it
        /// was, while it goes, and it cannot be pressed meanwhile.
        exit: option<shift>,
    }

    /// What the application says of an element while the pointer rests on it: the tooltip of a
    /// button that is an icon alone, with the keys that do the same.
    record tip {
        /// A part of the frame's `text`.
        words: slice,
        /// The keys, as the page writes them: a part of the frame's `text`.
        keys: option<slice>,
    }

    /// One element of the tree. The tree is a flat list in depth-first order: an element is
    /// followed by its children, each followed by its own.
    record node {
        content: content,
        style: style,
        id: option<id>,
        /// The pointer can hover it and press it.
        pressable: bool,
        /// The keyboard can be on it.
        focusable: bool,
        /// The box is the room of a text field the application puts over the page, of this
        /// kind. The field is named by the element's `id`, and an element with no id is not a
        /// field; a page has as many as it names. The first text inside the element is what the
        /// field says while it is empty: the application draws it, the page does not.
        field: option<field-kind>,
        /// What the element is in words, for a person who does not see it (a screen reader says
        /// it): a part of the frame's `text`. A button that is an icon alone says what it does;
        /// an element with none is read by the words inside it.
        label: option<slice>,
        motion: option<motion>,
        tip: option<tip>,
        /// What it is to a screen reader, where its look says it.
        role: option<accessible-role>,
        state: state,
        /// What the page can be told to do while the keyboard is on this element or inside it:
        /// a part of the frame's `commands`. The commands of the outermost element can be done
        /// whatever has the keyboard; where two say the same keys, the nearer the keyboard is done.
        commands: slice,
        /// The keyboard is on this element (the first that says so).
        focused: bool,
        /// It can be picked up and moved (it answers the pointer as a pressed element does).
        draggable: bool,
        /// What is moved can be put down on it.
        drop-target: bool,
        /// How many elements that follow are this one's children (not grandchildren).
        children: u32,
    }

    /// A page ready to be laid out.
    ///
    /// What a frame says that is not of a fixed size (the words, the paths of pictures, the values
    /// of sparklines, the tracks of grids) is in three lists, once for the whole frame, and an
    /// element names the part it means. So the application copies each byte of a frame once, and
    /// what it takes in is the size of the module's own memory: it is not the size of a buffer
    /// times the number of elements that point at it. Parts may overlap (the same words twice cost
    /// the module nothing), but each use counts toward what the application lets a frame say, and
    /// a part that is not within its list, or does not end where a character does, is not a page.
    record frame {
        nodes: list<node>,
        /// The words of every line of text and the path of every picture.
        text: string,
        /// The values of every sparkline.
        numbers: list<f32>,
        /// The columns and rows of every grid.
        tracks: list<track>,
        /// The parts of every text of many looks.
        spans: list<span>,
        /// The paths of every canvas.
        paths: list<path>,
        /// The steps of every path.
        segments: list<segment>,
        /// The commands of every element.
        commands: list<command>,
        /// The page is still moving: the application asks for the next frame itself until this
        /// says no, so a page at rest costs no frames.
        animating: bool,
        /// When the page wants to be asked for again even if nothing happens before then, in
        /// seconds on the clock `render` was given: a page that shows how old what it shows is (a
        /// reading that stopped coming) is woken once at that time, not drawn at every frame
        /// until then. Not read while the page is `animating`; a time already past is now.
        wake-at: option<f64>,
    }

    enum button {
        left,
        right,
        /// The wheel pressed down, or the third button.
        middle,
    }

    record mods {
        shift: bool,
        control: bool,
        /// The alt (option) key.
        alt: bool,
        command: bool,
    }

    /// A key the page reads. Letters, symbols and the space bar come as `character`.
    variant key {
        up,
        down,
        left,
        right,
        page-up,
        page-down,
        home,
        end,
        enter,
        escape,
        tab,
        /// The key that deletes the character before the caret (⌫).
        backspace,
        /// The key that deletes the character after it (⌦, fn-⌫ on a Mac's keyboard).
        delete,
        /// A function key, F1 to F20.
        function(u8),
        character(char),
    }

    record press {
        at: point,
        button: button,
        mods: mods,
        /// Which press of a quick run of them this is, from 1: `2` is the second of a double
        /// click, as the system counts them (its own time and distance between the two).
        count: u32,
    }

    record release {
        at: point,
        button: button,
    }

    /// The wheel or the trackpad where no box the application scrolls took it: the points the
    /// content would move left by (`dx`) and up by (`dy`). For a page that does something of its
    /// own with the wheel (a zoom, a value that steps).
    record scroll {
        at: point,
        dx: f32,
        dy: f32,
    }

    /// The text a field of the application's holds.
    record field-text {
        /// The field: the id of the element that is its room.
        field: id,
        text: string,
    }

    record key-press {
        key: key,
        mods: mods,
    }

    /// Files dropped on the page from outside it: where, and their paths, as the system the
    /// application runs on writes them.
    record dropped-files {
        at: point,
        paths: list<string>,
    }

    /// Where a box the application scrolls stands now: its id and how far it is scrolled across
    /// and down, points.
    record scrolled {
        id: id,
        offset: point,
    }

    /// One thing the person did, in the page's points (its top-left corner is the origin).
    variant event {
        pointer-move(point),
        pointer-leave,
        press(press),
        release(release),
        scroll(scroll),
        key(key-press),
        /// The text of one of the application's fields changed: the person typed, pasted or
        /// deleted. Not said for a text the page itself put in (`reply.fill`).
        text(field-text),
        /// The keyboard went to a field the person clicked into (its id), or back to the page
        /// (none) when the field let it go of itself. Not said when it moved where the page's
        /// own reply sent it.
        focus(option<id>),
        /// The person picked the entry with this index of the menu the page asked for.
        menu-pick(u32),
        /// A key the page was told of went up.
        key-up(key-press),
        /// The modifiers held changed, with no other key.
        mods(mods),
        /// The person asked for the command of this name, from the application's list of them or
        /// by its keys (the key is not told as well).
        command(id),
        /// Files were dropped on the page.
        files(dropped-files),
        /// The application scrolled these boxes (the wheel, the trackpad, a scroll bar, or what
        /// the page asked): a page that builds only what is in view builds what came into it.
        scrolled(list<scrolled>),
    }

    /// The shape the pointer takes over the page.
    enum cursor {
        arrow,
        /// Over something that answers a click.
        pointer,
        /// Over the room of a text field.
        text,
        /// Over an edge that is dragged left and right (a column's, a divider's).
        resize-horizontal,
        /// Over an edge that is dragged up and down.
        resize-vertical,
        /// Over something that cannot be used now.
        not-allowed,
        /// Over something that can be picked up and moved.
        grab,
        /// While it is being moved.
        grabbing,
        /// Where a point is picked.
        crosshair,
    }

    /// Where the keyboard goes.
    variant keyboard {
        /// The page's own keys.
        page,
        /// The field named by this id.
        field(id),
    }

    record menu-item {
        /// A part of the menu's `titles`.
        title: slice,
        /// The key that does the same on the page, shown at the end of the line.
        key: option<char>,
        enabled: bool,
    }

    variant menu-entry {
        item(menu-item),
        separator,
    }

    /// A menu for the application to pop up at `at`. The entries' titles are in one string, as the
    /// words of a frame are (see `frame`).
    record menu {
        at: point,
        entries: list<menu-entry>,
        titles: string,
    }

    /// What the page says back after an event.
    record reply {
        /// Something the page shows changed: a frame is worth drawing.
        redraw: bool,
        /// The page asks to be closed.
        close: bool,
        menu: option<menu>,
        keyboard: option<keyboard>,
        /// Texts for fields to hold from now on, in place of what they hold: a field the page
        /// empties after it took what was typed, or fills with what is to be edited. A field
        /// the page does not name keeps what the person typed; a name that is not a field of
        /// the page as last laid out is passed over.
        fill: list<field-text>,
        /// Text for the pasteboard.
        copy: option<string>,
        /// The pointer's shape after this event.
        cursor: cursor,
    }
}

/// What the module can ask of the page as the application last laid it out. The answers come
/// from that layout, which may be a frame behind the tree the module has handed out since.
interface layout {
    use types.{id, point, rect, extent};

    /// The element under `at` that answers the pointer: the topmost.
    hit: func(at: point) -> option<id>;
    /// The named elements whose visible part holds `at`, innermost first.
    ids-at: func(at: point) -> list<id>;
    /// The box of the element named `id`, points.
    bounds: func(id: id) -> option<rect>;
    /// How far the scrolling box named `id` reaches, and how far it is scrolled.
    scroll-extent: func(id: id) -> option<extent>;
    /// Asks for the scrolling box named `id` to be scrolled to `x` across and `y` down (points;
    /// one not given stays where it is; past the end is the end), over a moment where `animate`
    /// (and the person has not asked for less motion), before the next frame is laid out. A box
    /// that is not on the page yet is there when it comes.
    scroll-to: func(id: id, x: option<f32>, y: option<f32>, animate: bool);
    /// The elements the keyboard can be on, in the order they are written.
    focus-order: func() -> list<id>;
    /// `id` and the named elements that hold it, innermost first.
    path-of: func(id: id) -> list<id>;
    /// The element under `at` that can be picked up and moved: the topmost.
    drag-source: func(at: point) -> option<id>;
    /// The element under `at` that what is dragged can be put down on: the topmost.
    drop-target: func(at: point) -> option<id>;
}

/// What the module can say to the program that opened the page, if one did.
interface program {
    /// What became of a message.
    enum delivery {
        /// The application has it and will carry it to the program, as it is and not read; the
        /// program is told it only while the page is open.
        accepted,
        /// The program has not read what it was told before: the message was not taken, the page
        /// keeps it, and `page.room` is called once when the program has read enough. A page
        /// that is told *full* and sends again before that is told *full* again.
        full,
    }

    /// A message for the program: one JSON object, written as text, which the application takes
    /// in once (a call is one string, not one per anything). A page that says more in one
    /// call than the application allows, or a message longer than the protocol's limit for one
    /// (1 MiB), is closed; one the program has not the room for is not (`delivery.full`).
    /// Returns at once; nothing comes back but what the program says in its own time
    /// (`page.message`).
    send: func(message: string) -> delivery;
}

/// Why a module cannot go on. A module that stops says so before it does, so the person is told
/// what happened and not only that the page is gone.
interface diagnostics {
    /// The module cannot go on: `message` is why, in words for a person (a script's error, with
    /// the line it is on). The application closes the page when the call that said it returns,
    /// whatever that call returns, and tells the program the message; it reads nothing the
    /// module handed out in that call.
    fail: func(message: string);
}

/// What a module that is a language's interpreter is given to run: the program's own text, and
/// the other scripts of the bundle it came in.
interface script {
    /// The path of the script in its bundle, as the bundle's manifest names it. The same every
    /// time it is asked. A script that loads another one finds it from here.
    path: func() -> string;

    /// The bytes of the script the application runs this module for, as the program sent them.
    /// The same every time it is asked.
    source: func() -> list<u8>;

    /// Whether the bundle has a script at `path`: a file the manifest types `text/x-lua`, with
    /// the path written as the manifest writes it. False for what is not in the bundle, what is
    /// of another type and any string that is not a path a manifest lists; never an error.
    has-module: func(path: string) -> bool;

    /// The bytes of the script at `path` (see `has-module`), as the program sent them, or why
    /// they are not given, in words for the person who wrote the script. A bundle can have more
    /// script than the application runs: what the module has been given in all, `source`
    /// included, is held to a limit, and past it this says so.
    module: func(path: string) -> result<list<u8>, string>;
}

/// What the module is: a page.
interface page {
    use types.{size, frame, event, reply};

    /// The page for a viewport of `size` points at time `now` (seconds on the application's
    /// clock). `reduce-motion` is the person's setting: a page that animates snaps instead.
    render: func(size: size, now: f64, reduce-motion: bool) -> frame;

    /// The application laid the page out: the module brings what depends on the layout (how
    /// far a list is scrolled against how far it can be) back within it. True when something
    /// changed and the page is worth rendering again.
    settle: func() -> bool;

    /// The person did something.
    handle: func(event: event) -> reply;

    /// The program that opened the page said something: one JSON object, as the program wrote
    /// it, which the module reads and may not trust. `redraw` of the reply says the page changed.
    message: func(message: string) -> reply;

    /// The program has read enough that a message `program.send` answered `full` to can be sent:
    /// called once for each time the page was told *full*, and never when it was not. The page
    /// sends what it kept. `redraw` of the reply says the page changed.
    room: func() -> reply;
}

world view {
    import layout;
    import program;
    import diagnostics;
    import script;
    export page;
}
