{
  "examples": [
    {
      "about": "what is typed goes in at every caret",
      "text": "a\nb\nc",
      "steps": [
        {
          "do": "select",
          "ranges": [
            [1, 1],
            [3, 3],
            [5, 5]
          ]
        },
        { "do": "type", "text": "!" },
        {
          "do": "expect",
          "text": "a!\nb!\nc!",
          "ranges": [
            [2, 2],
            [5, 5],
            [8, 8]
          ]
        }
      ]
    },
    {
      "about": "ranges that meet or overlap become one",
      "text": "abcd",
      "steps": [
        {
          "do": "select",
          "ranges": [
            [1, 1],
            [1, 1],
            [2, 3]
          ]
        },
        {
          "do": "expect",
          "ranges": [
            [1, 1],
            [2, 3]
          ]
        },
        {
          "do": "select",
          "ranges": [
            [0, 2],
            [1, 3]
          ]
        },
        { "do": "expect", "ranges": [[0, 3]] },
        {
          "do": "select",
          "ranges": [
            [3, 4],
            [0, 1]
          ],
          "main": 0
        },
        {
          "do": "expect",
          "ranges": [
            [0, 1],
            [3, 4]
          ],
          "main": 1
        }
      ]
    },
    {
      "about": "carets side by side that delete come to one",
      "text": "abcd",
      "steps": [
        {
          "do": "select",
          "ranges": [
            [1, 1],
            [2, 2]
          ]
        },
        { "do": "command", "command": "delete_backward" },
        { "do": "expect", "text": "cd", "ranges": [[0, 0]] }
      ]
    },
    {
      "about": "a caret added below keeps its column, as near as the line lets it",
      "text": "abc\nde\nfghi",
      "steps": [
        { "do": "select", "ranges": [[2, 2]] },
        { "do": "command", "command": "add_caret_below" },
        {
          "do": "expect",
          "ranges": [
            [2, 2],
            [6, 6]
          ],
          "main": 1
        },
        { "do": "command", "command": "add_caret_below" },
        {
          "do": "expect",
          "ranges": [
            [2, 2],
            [6, 6],
            [9, 9]
          ],
          "main": 2
        },
        { "do": "command", "command": "single_selection" },
        { "do": "expect", "ranges": [[9, 9]] }
      ]
    },
    {
      "about": "selecting the next takes the word at the caret, then where it comes again",
      "text": "foo bar foo",
      "steps": [
        { "do": "select", "ranges": [[1, 1]] },
        { "do": "command", "command": "select_next" },
        { "do": "expect", "ranges": [[0, 3]] },
        { "do": "command", "command": "select_next" },
        {
          "do": "expect",
          "ranges": [
            [0, 3],
            [8, 11]
          ],
          "main": 1
        },
        { "do": "type", "text": "x" },
        { "do": "expect", "text": "x bar x" }
      ]
    },
    {
      "about": "a paste of as many lines as there are carets puts a line at each",
      "text": "a\nb",
      "steps": [
        {
          "do": "select",
          "ranges": [
            [1, 1],
            [3, 3]
          ]
        },
        { "do": "paste", "text": "1\n2" },
        { "do": "expect", "text": "a1\nb2" }
      ]
    },
    {
      "about": "a move down keeps the column it started at across a short line",
      "text": "abcdef\nab\nabcdef",
      "steps": [
        { "do": "select", "ranges": [[5, 5]] },
        { "do": "command", "command": "move", "movement": "down" },
        { "do": "expect", "ranges": [[9, 9]] },
        { "do": "command", "command": "move", "movement": "down" },
        { "do": "expect", "ranges": [[15, 15]] },
        { "do": "command", "command": "move", "movement": "down" },
        { "do": "expect", "ranges": [[16, 16]] }
      ]
    }
  ]
}
