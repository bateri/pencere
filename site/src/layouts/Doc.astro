---
// A document of the repository as a page: the document in a narrow column, and beside it the list
// of its sections, which follows the page. What the page is, and which file it shows, is its line
// in the site's map (src/docs.js); the Markdown is read when the site is built.
import Base from "./Base.astro";
import Numbered from "../components/Numbered.astro";
import DocsMenu from "../components/DocsMenu.astro";
import ModuleList from "../components/ModuleList.astro";
import SectionList, { type Section } from "../components/SectionList.astro";
import SidePlace from "../components/SidePlace.astro";
import { REPO } from "../lib/code.js";
import { read } from "../lib/repo.js";
import { regionsOf } from "../../scripts/regions.mjs";
import catalog from "../data/catalog.json";

interface Props {
  /** The page's line in the map. */
  page: {
    path: string;
    words: string;
    source: string;
    title: string;
    description: string;
    area?: string;
    sections?: string[];
    opening?: boolean;
    heading?: string;
    alone?: boolean;
    note?: string;
    whole?: [string, string];
    shows?: string;
    crumbs?: [string, string][];
    index?: boolean;
    code?: string;
    element?: string;
    lift?: boolean;
    of?: string;
    components?: boolean;
  };
  headings: { depth: number; slug: string; text: string }[];
}
const { page, headings } = Astro.props;
const { title, description, path, words: name, source, note = "", crumbs = [], whole, heading, sections: only, opening = true, shows = source, code, element, lift = false, components = false } = page;
// The parts of an example a page shows beside its rules: each under the heading of its name.
const regions = code ? regionsOf(read(code), code).regions : undefined;
// The picture and the code of the element a topic is where to read of: after what the page opens with.
// A browser, which the host draws in a room of its own, has no picture.
const kind = element ? catalog.elements.find((entry) => entry.name === element) : undefined;
if (element && !kind) throw new Error(`${path}: src/docs.js names the element ${element}, and the catalogue has none.`);
const demo = kind?.demo ? kind : undefined;
// A topic of the kit's page API has a page of its own: its sections are the page's lower level (smaller
// than the sections of the protocol, which are the document's chapters), and they are the chapters again
// where the topics are shown together (`/kit/spec/all`).
const topic = /^kit\/spec\/[a-z0-9-]+\.md$/.test(source) && path !== "kit/spec/all";
// A page of the documentation has its menu, with the list of the sections open under the page's own line.
const docs = !page.alone;

// A heading's number and its title, apart: "9. Messages and the bridge of a page", "9.2 The six messages".
const apart = (text: string) => {
  const found = text.match(/^(Appendix [A-Z]|\d+(?:\.\d+)*)\.?\s+(.*)$/);
  return { number: found ? found[1].replace("Appendix ", "") : "", title: found ? found[2] : text };
};
// The sections, each with the sections inside it.
const sections: Section[] = [];
let shown = true;
// A page that is one section of the document has that section's heading for its title: what is inside
// it is the page's sections, one level up.
const up = lift ? 1 : 0;
for (const entry of headings) {
  // Of a part of a document, the sections that are shown and what is inside them.
  if (entry.depth === 2) shown = !only || only.includes(entry.slug);
  if (!shown || entry.depth < 2 + up) continue;
  const depth = entry.depth - up;
  const section = { slug: entry.slug, ...apart(entry.text), inside: [] };
  if (depth === 2) sections.push(section);
  else if (depth === 3) sections.at(-1)?.inside.push(section);
  // A part of a section inside a section (the modules of the kit's library): no number, its name alone.
  else if (depth === 4) sections.at(-1)?.inside.at(-1)?.inside.push({ ...section, number: "", title: entry.text });
}
// The page's own title (the document's first heading, or the section that is the page): a hit on it is a
// hit on the page.
const top = lift ? headings.find((entry) => entry.depth === 2 && only?.includes(entry.slug)) : headings.find((entry) => entry.depth === 1);
const numbered = sections.some((section) => section.number);
// A document of one section has nothing to list beside it.
const listed = sections.length > 1;
---
<Base title={title} description={description} path={path} index={page.index} apps={(page.area ?? page.of) === "apps"}>
  <div class="wrap kit">
    <aside data-pagefind-ignore class:list={["side", "spec__side", { "spec__side--alone": !docs }]} aria-label={docs ? "Documentation, and the sections of this page" : "Sections"}>
      {
        docs ? (
          <DocsMenu path={path}>
            {
              lift ? (
                <ModuleList path={path}>{listed && <SectionList sections={sections} numbered={numbered} />}</ModuleList>
              ) : (
                listed && <SectionList sections={sections} numbered={numbered} />
              )
            }
          </DocsMenu>
        ) : (
          listed && (
            <>
              <h2 class="spec__name">{name}</h2>
              <SectionList sections={sections} numbered={numbered} />
            </>
          )
        )
      }
    </aside>
    <SidePlace />
    <!-- Search names a page as the menu does (read from an attribute: a name may hold a comma), and
         says which heading is the document's own title. -->
    <article class:list={["doc", "spec", { "spec--titled": heading, "spec--topic": topic }]} data-pagefind-meta="title[data-title], top[data-top]" data-title={name} data-top={top?.slug ?? ""}>
      {crumbs.length > 0 && <p class="crumbs">{crumbs.map(([words, address], i) => <>{i > 0 && " / "}<a href={address}>{words}</a></>)}</p>}
      {heading && <h1>{heading}</h1>}
      <Numbered source={source} path={path} keep={only} opening={opening} lift={lift} components={components} regions={regions} example={code} demo={demo}><slot /></Numbered>
      {whole && <p class="spec__whole"><a href={whole[1]}>{whole[0]}</a></p>}
      <p class="spec__said" role="status" aria-live="polite"></p>
      <p class="spec__source" data-pagefind-ignore>
        This page is {only ? "a part of " : ""}<a href={`${REPO}/blob/main/${shows}`}>{shows}</a> of the repository{note}.
      </p>
    </article>
  </div>
</Base>

<script>
  // A heading's link copies the address of its section, and goes there as a link does. For a moment
  // the link shows a tick in place of its chain, and the page says so to a screen reader. Where the
  // browser will not let a page write to the clipboard nothing is claimed: the link has still gone
  // to the heading, and the address is in the browser's bar.
  const said = document.querySelector<HTMLElement>(".spec__said");
  const copied = new WeakMap<Element, number>();
  for (const anchor of document.querySelectorAll<HTMLAnchorElement>(".spec .anchor")) {
    anchor.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(new URL(anchor.hash, location.href).href);
      } catch {
        return;
      }
      anchor.classList.add("is-copied");
      if (said) said.textContent = "Link copied";
      clearTimeout(copied.get(anchor));
      copied.set(
        anchor,
        window.setTimeout(() => {
          anchor.classList.remove("is-copied");
          if (said) said.textContent = "";
        }, 1600),
      );
    });
  }

  // The list beside the document follows the page: the section that is being read is marked in it,
  // and the sections inside that one open under it. The section being read is the last whose
  // heading has passed a line near the top of the window. A mark on the list's rail goes to the
  // line that is being read; it is moved here, a little each frame, because the lines of the list
  // are themselves moving while a section opens and another closes.
  const side = document.querySelector<HTMLElement>(".spec__side");
  const list = side?.querySelector<HTMLElement>(".spec__list");
  // What scrolls is the side, the kit's menu and the list in it together.
  const scroller = side;
  const mark = side?.querySelector<HTMLElement>(".spec__mark");
  const links = new Map<string, HTMLAnchorElement>();
  for (const link of list?.querySelectorAll<HTMLAnchorElement>("a[href^='#']") ?? []) links.set(decodeURIComponent(link.hash.slice(1)), link);
  const headings = [...document.querySelectorAll<HTMLElement>(".spec :is(h2, h3, h4)[id]")].filter((heading) => links.has(heading.id));
  if (side && list && scroller && mark && headings.length) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const LINE = 96;
    let tops: number[] = [];
    const measure = () => (tops = headings.map((heading) => heading.getBoundingClientRect().top + scrollY));

    // The mark: where it is, and the line it is going to.
    let here: HTMLAnchorElement | null = null;
    let y = 0, tall = 0, shown = false, moving = 0, until = 0;
    const place = (now: number) => {
      moving = 0;
      if (!here) return;
      const box = here.getBoundingClientRect(), frame = list.getBoundingClientRect();
      const toY = box.top - frame.top + 5, toTall = box.height - 10;
      const ease = still.matches || !shown ? 1 : 0.24;
      y += (toY - y) * ease;
      tall += (toTall - tall) * ease;
      shown = true;
      mark.style.transform = `translateY(${y.toFixed(2)}px)`;
      mark.style.height = `${tall.toFixed(2)}px`;
      mark.style.opacity = "1";
      if (now < until || Math.abs(toY - y) > 0.3 || Math.abs(toTall - tall) > 0.3) moving = requestAnimationFrame(place);
    };
    const go = () => {
      // The lines of the list go on moving for as long as a section takes to open.
      until = performance.now() + 420;
      if (!moving) moving = requestAnimationFrame(place);
    };

    let last: string | null = null;
    const follow = () => {
      // Binary search: the last heading above the line.
      let low = 0, high = tops.length - 1, at = -1;
      const line = scrollY + LINE;
      while (low <= high) {
        const middle = (low + high) >> 1;
        if (tops[middle] <= line) (at = middle), (low = middle + 1);
        else high = middle - 1;
      }
      const id = at < 0 ? "" : headings[at].id;
      if (id === last) return;
      last = id;
      for (const el of list.querySelectorAll(".is-here, .is-open")) el.classList.remove("is-here", "is-open");
      const link = links.get(id) ?? null;
      here = link;
      if (!link) {
        mark.style.opacity = "0";
        shown = false;
        return;
      }
      // The line of the heading, and every line it is inside: each is marked, and each is open.
      for (let item = link.closest("li"); item && list.contains(item); item = item.parentElement?.closest("li") ?? null) {
        item.classList.add("is-open");
        item.querySelector(":scope > a")?.classList.add("is-here");
      }
      go();
      // Keep the line in sight in the list, where the list is longer than the window.
      // (At the top of the page the list's own end is below the window's: what is in sight ends there.)
      const box = link.getBoundingClientRect(), frame = scroller.getBoundingClientRect();
      const end = Math.min(frame.bottom, innerHeight);
      if (box.top < frame.top + 40 || box.bottom > end - 40) {
        scroller.scrollTo({ top: scroller.scrollTop + box.top - frame.top - (end - frame.top) / 3, behavior: still.matches ? "auto" : "smooth" });
      }
    };
    let waiting = false;
    addEventListener(
      "scroll",
      () => {
        if (waiting) return;
        waiting = true;
        requestAnimationFrame(() => ((waiting = false), follow()));
      },
      { passive: true },
    );
    new ResizeObserver(() => (measure(), follow(), go())).observe(document.querySelector(".spec")!);
    measure();
    follow();
  }
</script>
