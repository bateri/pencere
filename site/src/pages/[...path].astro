---
// Every page that is a document of the repository: the site's map says which they are
// (src/docs.js, the pages with a `source`), and nothing of a document is kept here.
import Doc from "../layouts/Doc.astro";
import { PAGES } from "../docs.js";
import { document } from "../lib/documents.js";

export function getStaticPaths() {
  return PAGES.filter((page) => page.source).map((page) => ({ params: { path: page.path }, props: { page } }));
}
const { page } = Astro.props;
const { Content, headings } = await document(page.source);
---
<Doc page={page} headings={headings}>
  <Content />
</Doc>
