---
import Kit from "../../layouts/Kit.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import Shot from "../../components/Shot.astro";
import SpecDoc from "../../components/SpecDoc.astro";
import catalog from "../../data/catalog.json";
import { elements } from "../../lib/project.js";

// What an element is, as the page API says it (src/lib/project.js).
const { says } = elements();
---
<Kit
  title="Elements: the pencere kit"
  description="The elements a page of the pencere kit is made of: boxes, text, pictures, paths, sparklines and the editor of text."
  path="kit/elements"
>
  <header>
    <h1>Elements</h1>
    <p class="lead" set:html={says} />
  </header>

  <div id="elements">
    {
      catalog.elements.map((element) => (
        <section class="element" id={element.name}>
          <h2><code>{element.constructor}</code></h2>
          <p set:html={element.doc} />
          {element.demo && (
            <div class="element__pair">
              <Shot name={`elements/${element.name}`} width={element.demo.width} height={element.demo.height} alt={`What ${element.constructor} draws`} />
              <CodeBlock code={element.demo.code} />
            </div>
          )}
          {element.more.map((extra) => (
            <div class="element__pair">
              <Shot name={extra.name} width={extra.width} height={extra.height} alt={`More of what ${element.constructor} draws`} />
              <CodeBlock code={extra.code} />
            </div>
          ))}
        </section>
      ))
    }
  </div>

  <SpecDoc source="kit/spec/elements.md" path="kit/elements" keep={["the-builders"]} opening={false} />
</Kit>
