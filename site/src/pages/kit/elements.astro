---
import Kit from "../../layouts/Kit.astro";
import Shot from "../../components/Shot.astro";
import SpecDoc from "../../components/SpecDoc.astro";
import { PAGES, elementPath } from "../../docs.js";
import catalog from "../../data/catalog.json";
import { elements } from "../../lib/project.js";

// What an element is, as the page API says it (src/lib/project.js).
const { says } = elements();

// Every element a page of the map names is one the catalogue has.
for (const page of PAGES.filter((entry) => entry.element)) {
  if (!catalog.elements.some((element) => element.name === page.element))
    throw new Error(`${page.path}: src/docs.js names the element ${page.element}, and the catalogue has none.`);
}
---
<Kit
  title="Elements: the pencere kit"
  description="The elements a page of the pencere kit is made of: boxes, text, pictures, paths, sparklines and the editor of text."
  path="kit/elements"
>
  <header>
    <h1>Elements</h1>
    <p class="lead" set:html={says} />
  </header>

  <!-- The cards stand in the place of the table of the builders, which says the same of each constructor
       (the table is in the document still: scripts/repeats.mjs sees that the page says it once). -->
  <SpecDoc source="kit/spec/elements.md" path="kit/elements" keep={["the-builders", "text-field", "tip", "overlay", "gradient"]} opening={false}>
    <div slot="instead" id="cards" class="cards">
      {
        catalog.elements.map((element) => (
          <a class:list={["card", { "card--wide": (element.demo?.width ?? 0) > 380 }]} href={`/${elementPath(element.name)}`}>
            {element.demo && <Shot name={`elements/${element.name}`} width={element.demo.width} height={element.demo.height} alt="" />}
            <b>pencere.{element.name}</b>
            <p set:html={element.doc} />
          </a>
        ))
      }
    </div>
  </SpecDoc>
</Kit>
