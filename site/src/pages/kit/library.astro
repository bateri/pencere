---
// The kit's library: its modules, each with the sentence the kit's own document opens its section
// with, and a link to that section. The names and the sentences are read from kit/SPEC.md when the
// site is built (src/lib/project.js); what a module has is said once, in the page API.
import Kit from "../../layouts/Kit.astro";
import { getHeadings } from "../../../../kit/SPEC.md";
import { library } from "../../lib/project.js";
import { REPO } from "../../lib/code.js";

const { says, modules } = library();
const headings = getHeadings();
const section = headings.find((heading) => heading.depth === 3 && /^2\.6\b/.test(heading.text));
const list = modules.map((module) => {
  const heading = headings.find((entry) => entry.depth === 4 && entry.text.replace(/`/g, "").trim() === module.name);
  if (!heading) throw new Error(`The page API has no section for ${module.name}.`);
  return { ...module, href: `/kit/spec#${heading.slug}` };
});
---
<Kit
  title="The library: the pencere kit"
  description="The modules of the pencere kit's library: components, syntax colouring, languages, fuzzy finding, keys, Markdown and the terminal's own look."
  path="kit/library"
>
  <header>
    <h1>The library</h1>
    <p class="lead" set:html={says} />
  </header>

  <ul class="modules">
    {
      list.map((module) => (
        <li>
          <a class="modules__go" href={module.href}>
            <b>{module.name}</b>
            <span set:html={module.says} />
          </a>
        </li>
      ))
    }
  </ul>

  <div class="prose" style="margin-top:32px">
    <p>
      Each line leads to the module's section of <a href={`/kit/spec#${section?.slug ?? ""}`}>the page API</a>, where
      everything it has is said. What <code>@pencere/ui</code> draws is shown, one by one, in
      <a href="/kit/components">the components</a>. An app that uses the others is
      <a href={`${REPO}/tree/main/examples/editor-lua`}>the editor among the examples</a>.
    </p>
  </div>
</Kit>
