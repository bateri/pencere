---
// The kit's library: what the document says of it, and its modules, each with the sentence the kit's own
// document opens its section with, and a link to the module's page. The names and the sentences are read
// from kit/spec/library.md when the site is built (src/lib/project.js); what a module has is said once, on
// its page, which is one section of the document (src/docs.js).
import Kit from "../../layouts/Kit.astro";
import SpecDoc from "../../components/SpecDoc.astro";
import { libraryPages } from "../../docs.js";
import { library } from "../../lib/project.js";
import { REPO } from "../../lib/code.js";
import { document, router } from "../../lib/documents.js";

const { modules } = library();
const pages = libraryPages();
// Each module of the document has its page in the map, and each page of the map is a module of the document.
const list = modules.map((module) => {
  const page = pages.find((entry) => entry.words === module.name);
  if (!page) throw new Error(`The site's map (src/docs.js) has no page for ${module.name}.`);
  return { ...module, href: `/${page.path}` };
});
for (const page of pages)
  if (!modules.some((module) => module.name === page.words))
    throw new Error(`${page.path}: the page API has no section for ${page.words}.`);
// The modules were sections of this page once: an address of one of their headings here (from a link
// kept somewhere else) is taken to the heading on the module's page.
const where = await router();
const moved = Object.fromEntries(
  (await document("kit/spec/library.md")).headings
    .filter((heading) => heading.depth >= 2)
    .map((heading) => [heading.slug, where("kit/spec/library.md", heading.slug)])
    .filter(([, to]) => to && !to.startsWith("/kit/library#")),
);
---
<Kit
  title="The library: the pencere kit"
  description="The modules of the pencere kit's library: components, syntax colouring, languages, fuzzy finding, keys, Markdown, the terminal's own look and what a page asks of its program."
  path="kit/library"
>
  <script is:inline define:vars={{ moved }}>
    const to = moved[decodeURIComponent(location.hash.slice(1))];
    if (to) location.replace(to);
  </script>
  <header>
    <h1>The library</h1>
  </header>

  <!-- What the document says of the library opens the page, the modules follow its first paragraph, and the rest
       of what it says is after them. -->
  <SpecDoc source="kit/spec/library.md" path="kit/library" keep={[]} untitled>
    <Fragment slot="after">
      <!-- The sentence of a module is said on its page, and search finds it there. -->
      <ul class="modules" data-pagefind-ignore>
        {
          list.map((module) => (
            <li>
              <a class="modules__go" href={module.href}>
                <b>{module.name}</b>
                <span set:html={module.says} />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="modules__note">
        Each line leads to the module's page, where everything it has is said. What <code>@pencere/ui</code> draws
        is shown, one by one, in <a href="/kit/components">the components</a>. An app that uses the others is
        <a href={`${REPO}/tree/main/examples/editor-lua`}>the editor among the examples</a>.
      </p>
    </Fragment>
  </SpecDoc>
</Kit>
