---
// The menu of the documentation: its pages by what a reader comes for, the same and in the same
// order on every page of an area, with the page the reader is on marked. The pages and their groups
// are the site's map (src/docs.js). What the page the reader is on opens (its sections, the
// components, the elements) is the layout's, given to the menu as its slot: it opens under that page's
// own line, so that where the reader is and what is in it are read in one place.
import { PAGES, menu } from "../docs.js";

interface Props {
  path: string;
}
const { path } = Astro.props;
// The page the reader is on, or the page it is under: a component's page is under Components. The
// longest address wins, so that every page of the kit is not under the kit's overview.
const here = PAGES.filter((page) => page.area && (path === page.path || path.startsWith(`${page.path}/`))).sort(
  (a, b) => b.path.length - a.path.length,
)[0];
const groups = menu(here?.area ?? "apps");
// The page itself is the page the reader is on; a page a reader is inside of (Elements, on an
// element's page) is the line its own pages open under.
const mark = (page: (typeof PAGES)[number]) => (page !== here ? undefined : page.path === path ? "page" : "true");
const opens = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
---
{
  groups.map((group) => (
    <>
      <h2>{group.name}</h2>
      <ul class="side__menu">
        {group.pages.map((page) => (
          <li class:list={{ "is-open": page === here && opens }}>
            <a href={`/${page.path}`} aria-current={mark(page)}>{page.words}</a>
            {page === here && opens && <div class="side__opens" set:html={opens} />}
          </li>
        ))}
      </ul>
    </>
  ))
}
