---
// The site's navigation, the same on every page. On the home page it lies over the scene; on the
// others it stands in the page's column (`column`), and says which part of the site this is (`path`).
import Mark from "./Mark.astro";
import Search from "./Search.astro";
import { REPO } from "../lib/code.js";

interface Props {
  path?: string;
  column?: boolean;
}
const { path = "", column = false } = Astro.props;
const under = (prefix: string) => path === prefix || path.startsWith(`${prefix}/`);
// The links are what a reader comes for. Start and the components are pages of the documentation
// with links of their own, so Docs is every other page of it.
const start = path === "kit/start";
const components = under("kit/components");
const here = { start, components, docs: (under("kit") || under("sdk")) && !start && !components, spec: under("spec") };
const mark = (on: boolean) => (on ? "page" : undefined);
---
<header class:list={["hn", { "hn--column": column }]}>
  <a class="hn__brand" href="/" aria-label="pencere, home"><Mark /> <span class="hn__word">pencere</span></a>
  <nav class="hn__links" aria-label="Site">
    <a href="/kit/start" aria-current={mark(here.start)}>Start</a>
    <a href="/kit" aria-current={mark(here.docs)}>Docs</a>
    <a class="hn__wide" href="/kit/components" aria-current={mark(here.components)}>Components</a>
    <a href="/spec" aria-current={mark(here.spec)}>Specification</a>
    <a class="hn__wide" href={REPO}>GitHub</a>
  </nav>
  <div class="hn__tools">
    <button class="hn__tool hn__search" type="button" aria-label="Search" aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /" data-tip="Search">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="9" cy="9" r="5.5" /><path d="M13.2 13.2L17 17" /></svg>
      <span class="hn__search-label">Search</span>
      <kbd class="hn__search-key" aria-hidden="true">⌘K</kbd>
    </button>
    <script is:inline>
      // Where the key is not ⌘ it is Ctrl: said before the page is first painted, so that the
      // control does not change as it is shown.
      (function () {
        var key = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent) ? "⌘K" : "Ctrl K";
        var search = document.querySelector(".hn__search");
        search.querySelector(".hn__search-key").textContent = key;
        search.setAttribute("data-tip", "Search (" + key + ")");
      })();
    </script>
    <button class="hn__tool hn__theme" type="button" aria-label="Light mode" data-tip="Light mode">
      <!-- The sun is shown in the dark theme (it switches to light), the moon in the light one. -->
      <svg class="hn__sun" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="3.4" />
        <path d="M10 2.6v1.8M10 15.6v1.8M2.6 10h1.8M15.6 10h1.8M4.8 4.8l1.3 1.3M13.9 13.9l1.3 1.3M4.8 15.2l1.3-1.3M13.9 6.1l1.3-1.3" />
      </svg>
      <svg class="hn__moon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M16.2 11.6A6.8 6.8 0 0 1 8.4 3.8a6.8 6.8 0 1 0 7.8 7.8z" />
      </svg>
    </button>
  </div>
</header>
<Search />
<script>
  // The theme button. The site follows the system's setting until it is pressed; it then switches to
  // the other theme, and when that is the system's own the choice is forgotten (the event pencere:theme,
  // answered in components/ThemeHead.astro, which also keeps it in localStorage).
  const button = document.querySelector<HTMLButtonElement>(".hn__theme");
  if (button) {
    const dark = matchMedia("(prefers-color-scheme: dark)");
    const chosen = () => document.documentElement.getAttribute("data-theme");
    const now = () => chosen() ?? (dark.matches ? "dark" : "light");
    // The button names what it does: the other theme.
    const say = () => {
      const name = now() === "dark" ? "Light mode" : "Dark mode";
      button.setAttribute("aria-label", name);
      button.dataset.tip = name;
    };
    button.addEventListener("click", () => {
      const next = now() === "dark" ? "light" : "dark";
      window.dispatchEvent(new CustomEvent("pencere:theme", { detail: next === (dark.matches ? "dark" : "light") ? null : next }));
    });
    window.addEventListener("themechange", say);
    dark.addEventListener("change", say);
    say();
  }
</script>
