---
// A document of the repository, shown on the site. Three things are done to it, and nothing else of
// what is inside is touched; a heading's id and its text stay what they were.
//
// A numbered heading has its number set apart from its title, so that a page can set the two
// differently: "9.2 The six messages" becomes a span of class num, "9.2", and the title.
//
// Every heading is given a link to itself, after its title: without a script the link goes to the
// heading, so the address can be taken from the browser; the page's script also copies the address
// and shows, in the link's own place, that it did (the link's two pictures: a chain, and a tick).
//
// A link to another file of the repository goes where that file is: to its page of the site when it
// has one (src/docs.js), and to the repository otherwise.
//
// A footnote is a note of the page (src/lib/notes.js). A heading that has a part of an example of its
// name (`regions`, scripts/regions.mjs) is followed, after what its section says of its own and before
// the next heading, by that code. The picture and the code of an element (`demo`) a topic is where to
// read of follow what the document opens with: its first paragraph.
import { posix } from "node:path";
import type { ComponentProps } from "astro/types";
import { REPO } from "../lib/code.js";
import { router } from "../lib/documents.js";
import { placeNotes, takeNotes } from "../lib/notes.js";
import { slug } from "../../scripts/links.mjs";
import CodeBlock from "./CodeBlock.astro";
import ElementDemo from "./ElementDemo.astro";

interface Props {
  /** The document's file in the repository ("cli/README.md"), and the address of the page it is shown on. */
  source: string;
  path: string;
  /** The sections to show, by the ids of their headings; none: the whole document. */
  keep?: string[];
  /** With `keep`: whether what the document says before its first section is shown too. */
  opening?: boolean;
  /** Leave out the document's own title (a page that has its own). */
  untitled?: boolean;
  /** The one section shown is the page: its heading is the page's title, and the headings in it go one level up. */
  lift?: boolean;
  /** Lead to the components' pages where the document lists them, and do not say their names again. */
  components?: boolean;
  /** The parts of an example to show, by the name of the heading each stands under, and the file they are of. */
  regions?: Map<string, string>;
  example?: string;
  /** An element of the kit, with its picture and its code, shown after the document's first paragraph. */
  demo?: ComponentProps<typeof ElementDemo>["element"];
}
const { source, path, keep, opening = true, untitled = false, lift = false, components = false, regions, example, demo } = Astro.props;
const at = posix.dirname(source) === "." ? "" : posix.dirname(source);
const BLOB = `${REPO}/blob/main/`;
// A link to a file of the repository goes to the page that shows it, and a link to a heading to
// the page that heading is on: a document shown in parts has its sections on more than one page,
// and a link inside it to one of its own headings may lead to another of them.
const page = await router();
const here = `/${path}`;
const where = (href: string) => {
  // A note's number and its link back (src/lib/notes.js) go to the note on the page, whichever page it is.
  if (href.startsWith("mailto:") || href.startsWith("#user-content-fn")) return href;
  let file: string;
  if (href.startsWith("#")) file = source + href;
  else if (href.startsWith(BLOB)) file = href.slice(BLOB.length);
  else if (/^[a-z][a-z0-9+.-]*:/i.test(href) || href.startsWith("//")) return href;
  else file = posix.normalize(posix.join(at, href));
  const [name, hash = ""] = file.split("#");
  // A directory is named for its README.
  const found = page(name, hash) ?? (/\.[a-z]+$/i.test(name) ? undefined : page(`${name.replace(/\/$/, "")}/README.md`, hash));
  if (found) return found.startsWith(`${here}#`) ? found.slice(here.length) : found;
  if (href.startsWith("#")) return href;
  return href.startsWith(BLOB) ? href : `${BLOB}${name}${hash ? `#${hash}` : ""}`;
};
// A page may be a part of a document: some of its sections, in the document's order. A section
// that is asked for and is not in the document stops the build, so that a page cannot go on
// showing less than it says when the document's headings change.
const { html: bare, notes } = takeNotes(await Astro.slots.render("default"));
const part = () => {
  const [before, ...sections] = bare.split(/(?=<h2[ >])/);
  const found = new Set<string>();
  const kept = sections.filter((section) => {
    const id = section.match(/^<h2 id="([^"]*)"/)?.[1] ?? "";
    if (keep!.includes(id)) found.add(id);
    return keep!.includes(id);
  });
  const missing = keep!.filter((id) => !found.has(id));
  if (missing.length) throw new Error(`${source} has no section ${missing.join(", ")}.`);
  return (opening ? before : "") + kept.join("");
};
const raised = (html: string) => (lift ? html.replace(/<(\/?)h([2-4])(?=[ >])/g, (_, close, level) => `<${close}h${Number(level) - 1}`) : html);
const shown = raised((keep ? part() : bare).replace(untitled ? /<h1[ >][\s\S]*?<\/h1>\s*/ : /(?!)/, ""));
const { html, end: notesAtEnd } = placeNotes(shown, notes);
// The notes at the page's end are links too: a note that points to another file would otherwise keep
// the path the document wrote it with, and be a 404 on the site.
const relink = (text: string) => text.replace(/<a href="([^"]*)"/g, (_, href) => `<a href="${where(href)}"`);
const end = relink(notesAtEnd);
const picture = (d: string, name: string) =>
  `<svg class="anchor__${name}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
const CHAIN = "M6.9 9.1a2.9 2.9 0 0 0 4.1 0l2.2-2.2a2.9 2.9 0 0 0-4.1-4.1l-.9.9M9.1 6.9a2.9 2.9 0 0 0-4.1 0L2.8 9.1a2.9 2.9 0 0 0 4.1 4.1l.9-.9";
const TICK = "M3.2 8.4l3.1 3.1 6.5-7";
const linked = relink(html)
  .replace(
    /<(h[2-4])( id="[^"]*")?>(Appendix [A-Z]|\d+(?:\.\d+)*)(\.?)\s+/g,
    (_, tag, id = "", number, dot) => `<${tag}${id}><span class="num">${number}${dot ? `<span class="num__dot">${dot}</span>` : ""}</span> `,
  )
  // A short name set as code is not broken over two lines (the styles of spec.css); a long one is.
  .replace(/<code>([^<]{1,32})<\/code>/g, '<code class="code--short">$1</code>')
  .replace(
    /<(h[2-4]) id="([^"]*)">([\s\S]*?)<\/\1>/g,
    (_, tag, id, inside) =>
      `<${tag} id="${id}">${inside}<a class="anchor" href="#${id}" aria-label="Copy a link to this section">${picture(CHAIN, "chain")}${picture(TICK, "tick")}</a></${tag}>`,
  );
// A page may put something of its own in the place of the document's table of the constructors (the
// slot `instead`): the elements' overview, whose cards say what that table says. The table stays in the
// document, and where the document is shown whole it is a table still.
const TABLE = /<table>\s*<thead>\s*<tr>\s*<th[^>]*>Constructor<\/th>[\s\S]*?<\/table>/;
const instead = ((Astro.slots.has("instead") && (await Astro.slots.render("instead"))) || "").trim();
if (instead && !TABLE.test(linked)) throw new Error(`${path}: ${source} has no table of the constructors for the page to put its own in the place of.`);
// The line that names the components (what the document says after their names stays): the page's own
// words lead to where each is shown, as the pages of the components have it.
const NAMES = /<li><code[^>]*>button<\/code>, [\s\S]*?(?=<code[^>]*>ui\.commands\(list\)<\/code>)/;
// The names and what follows them are one item of a list: a match that runs past its end would take the
// end of the list with it.
if (components && !linked.match(NAMES)?.[0].match(/^(?:(?!<\/li>)[\s\S])*$/))
  throw new Error(`${path}: ${source} has no item that lists the components for the page to lead from.`);
const led = components
  ? linked.replace(NAMES, () => '<li>What the module draws is shown, one by one, in <a href="/kit/components">the components</a>. ')
  : linked;
const swapped = instead ? led.replace(TABLE, () => instead) : led;
// A page may put something of its own after the document's first paragraph (the slot `after`): the library's
// modules, between what the document says it is and what else it says of it.
const after = ((Astro.slots.has("after") && (await Astro.slots.render("after"))) || "").trim();
if (after && !swapped.includes("</p>")) throw new Error(`${path}: ${source} has no paragraph for the page to put its own after.`);
// The first paragraph is one of the document's own, not one in a quote, a list or a table, where the page's
// would go in with it.
if (after && /<(?:blockquote|li|td|th)[ >]/.test(swapped.slice(0, swapped.indexOf("</p>"))))
  throw new Error(`${path}: the first paragraph of ${source} is in a quote, a list or a table, and the page's own would go in there.`);
const numbered = after ? swapped.replace("</p>", () => `</p>\n${after}`) : swapped;
// What a section says of its own ends at the next heading: the page is cut there, and the code of a
// part of an example whose name is the heading's goes in the cut. A heading with a part that the page
// has no heading for stops the build, so that none is left out unseen.
//
// A part and a heading are matched by their slugs, not by their words: the builder sets the heading's
// words with curly quotes and entities (`don't` becomes `don’t`, `&` becomes `&amp;`), and the file
// that has the part writes them as they are in the Markdown. scripts/regions.mjs matches the same way.
const ENTITIES: Record<string, string> = { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" };
const decode = (text: string) =>
  text.replace(/&(?:#(\d+)|#x([\da-f]+)|([a-z]+));/gi, (whole, dec, hex, name) =>
    dec || hex ? String.fromCodePoint(parseInt(dec ?? hex, dec ? 10 : 16)) : (ENTITIES[name.toLowerCase()] ?? whole),
  );
const title = (chunk: string) => {
  const inside = chunk.match(/^<h[2-4] id="[^"]*">([\s\S]*?)<a class="anchor"/)?.[1];
  return inside === undefined ? undefined : slug(decode(inside.replace(/<[^>]*>/g, "")));
};
const parts = new Map([...(regions ?? [])].map(([name, code]) => [slug(name), { name, code }]));
const used = new Set<string>();
const chunks = numbered.split(/(?=<h[2-4][ >])/).map((chunk) => {
  const key = parts.size ? title(chunk) : undefined;
  const part = key === undefined ? undefined : parts.get(key);
  if (part) used.add(part.name);
  return { chunk, code: part?.code };
});
// The file is named over the first of the page's codes only: it is the same file under each heading.
const firstCode = chunks.findIndex(({ code }) => code !== undefined);
// Where the element is shown: in what the page opens with (before its first section), after its first
// paragraph; where that has none, before the first section.
const first = chunks[0]?.chunk ?? "";
if (demo && /^<h[2-4][ >]/.test(first)) throw new Error(`${path}: the page opens with a section, and there is no place for the picture of the element.`);
const cut = demo ? (first.includes("</p>") ? first.indexOf("</p>") + 4 : first.length) : 0;
const left = [...parts.values()].map(({ name }) => name).filter((name) => !used.has(name));
if (left.length) throw new Error(`${path}: ${example} has parts that no heading of the page names: ${left.join(", ")}.`);
---
{chunks.map(({ chunk, code }, index) => <>{index === 0 && demo ? <><Fragment set:html={chunk.slice(0, cut)} /><ElementDemo element={demo} /><Fragment set:html={chunk.slice(cut)} /></> : <Fragment set:html={chunk} />}{code !== undefined && <CodeBlock code={code} name={index === firstCode ? example : undefined} />}</>)}
<Fragment set:html={end} />
