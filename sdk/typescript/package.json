{
  "name": "@pencere/sdk",
  "version": "0.1.1",
  "description": "Show a view in the terminal pane your program runs in",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bateri/pencere/tree/main/sdk/typescript#readme",
  "bugs": "https://github.com/bateri/pencere/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bateri/pencere.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "terminal",
    "pencere",
    "view",
    "webassembly",
    "lua"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "rm -rf dist tsconfig.tsbuildinfo && tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
