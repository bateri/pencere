{
  "name": "@pencere/sdk",
  "version": "0.1.1",
  "description": "Show an MCP App view in the terminal pane your MCP server runs in",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bateri/pencere/tree/main/sdk/typescript#readme",
  "bugs": "https://github.com/bateri/pencere/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bateri/pencere.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "terminal",
    "pencere"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "rm -rf dist tsconfig.tsbuildinfo && tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  }
}
