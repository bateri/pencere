{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "description": "A pencere tool: an MCP server whose view opens in the terminal pane",
  "type": "module",
  "scripts": {
    "build": "npm run build:view && npm run build:server",
    "build:view": "vite build && vite build --mode single",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/server/main.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.3.1",
    "@pencere/sdk": "^0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pencere/cli": "^0.1.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
