{
  "name": "@pencere/cli",
  "version": "0.1.0",
  "description": "Run an MCP server written in any language as a pencere program, so its MCP App view opens in the terminal pane",
  "license": "Apache-2.0",
  "homepage": "https://github.com/bateri/pencere/tree/main/cli#readme",
  "bugs": "https://github.com/bateri/pencere/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bateri/pencere.git",
    "directory": "cli"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "terminal",
    "pencere",
    "cli"
  ],
  "type": "module",
  "bin": {
    "pencere": "./dist/main.js"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "rm -rf dist tsconfig.tsbuildinfo && tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@pencere/sdk": "^0.1.1"
  }
}
